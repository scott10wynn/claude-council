# Local per-developer settings (md, json, etc.)
.claude/*.local.*

# Local commands (dev workflows)
.claude/commands/

# Response cache
.claude/council-cache/

# Issue tracker (personal)
.beads/

# Session state (cs session manager)
.cs/

# Web/page cache (claude-crawl)
.claude-crawl/

# Skill-creator iteration output
claude-council-workspace/

# OS files
.DS_Store

# Editor files
*.swp
*.swo
*~
autoresearch-results.tsv

# Job Applicator
job-applicator/data/
job-applicator/uploads/
job-applicator/__pycache__/

# Secret / environment files — never commit these
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
